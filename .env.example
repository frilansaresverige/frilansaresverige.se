# Copy to .env.local for development. In production these go in the .env file
# next to docker-compose.yml on the server (see deploy/docker-compose.yml).

# Used for links in e-mails.
SITE_URL=http://localhost:3000

# The existing uppdrag database.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Confirmation e-mails.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Frilansare Sverige <...@...>"
EMAIL_BCC=
# Sends every e-mail here instead of to the real recipient.
EMAIL_TO_OVERRIDE=

# Slack bot token, used for assignment posts and the member count.
SLACK_TOKEN=
SLACK_CHANNEL_BROKER=#...
SLACK_CHANNEL_DIRECT=#...
# SLACK_MEMBER_COUNT_CHANNEL=C8P11NBEF

# The bot that refers Slack's built-in invite requests to the application
# form. Needs the app's signing secret and the invite request channel (id or
# name). Dry-run only describes, in the request's thread, what it would send.
SLACK_SIGNING_SECRET=
SLACK_INVITE_REQUEST_CHANNEL=
INVITE_REQUEST_DRY_RUN=true
# Slack user ids (comma-separated) who may edit the reply to invite requests
# without being workspace admins.
SLACK_TEMPLATE_EDITORS=

# Incoming webhook for membership applications.
SLACK_REQUEST_INVITE_WEBHOOK_URL=

# Build time only; see the Dockerfile.
GOOGLE_ANALYTICS_ID=
